{%- macro faqSection(questions) -%}

{% from 'macros/faq/faq-schema.njk' import faqSchema %}
{{ faqSchema(questions) }}

<div class="accordion">

  {%- for question in questions -%}
    <h4 class="accordion-title font-bold text-2xl mb-2 text-orange-800">{{ question.fields.question }}</h4>
    <div class="accordion-panel pb-4">
      {{ question.fields.answer | md | safe }}
    </div>
  {%- endfor -%}

</div>

{%- endmacro -%}