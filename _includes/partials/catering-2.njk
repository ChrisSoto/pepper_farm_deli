<div class="container mx-auto px-4 py-8 max-w-3xl">
        <form id="cateringForm" class="space-y-8">
            <!-- Step 1: Tray Selection -->
            <div class="form-step active" id="step1">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Step 1: Select Your Trays</h2>
                
                <div class="bg-white rounded-lg shadow p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-700 mb-4">Classic Tray - $80</h3>
                    <select name="classicTrayCount" id="classicTrayCount" 
                            class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>

                    <div id="classicTrayChoices" class="space-y-4">
                        <!-- This will be populated dynamically based on tray count -->
                        <!-- Example for one tray: -->
                        <div class="tray-meats p-4 border rounded">
                            <p class="font-medium mb-2">Tray 1 Selections (Choose 2):</p>
                            <select class="meat-choice mb-2 w-full">
                                <option value="">Select first meat</option>
                                <option value="turkey">Turkey</option>
                                <option value="roastBeef">Roast Beef</option>
                                <option value="veggie">Veggie</option>
                            </select>
                            <select class="meat-choice w-full">
                                <option value="">Select second meat</option>
                                <option value="turkey">Turkey</option>
                                <option value="roastBeef">Roast Beef</option>
                                <option value="veggie">Veggie</option>
                            </select>
                        </div>
                    </div>
                    
                    <h3 class="text-lg font-semibold text-gray-700 mb-4 mt-6">Signature Tray - $100</h3>
                    <select name="signatureTrayCount" id="signatureTrayCount"
                            class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>
                </div>

                <div class="bg-white rounded-lg shadow p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-700 mb-4">Add-ons</h3>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between gap-4">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="addons" value="pickle" data-price="1" 
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Pickle Spear ($1)</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="number" min="0" value="0" 
                                       class="addon-quantity w-20 p-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       data-addon="pickle" disabled>
                                <span class="addon-total w-24 text-right font-medium">$0.00</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="addons" value="chips" data-price="3"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Chips ($3)</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="number" min="0" value="0" 
                                       class="addon-quantity w-20 p-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       data-addon="chips" disabled>
                                <span class="addon-total w-24 text-right font-medium">$0.00</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="addons" value="dessert" data-price="5.99"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Dessert ($5.99)</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="number" min="0" value="0" 
                                       class="addon-quantity w-20 p-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       data-addon="dessert" disabled>
                                <span class="addon-total w-24 text-right font-medium">$0.00</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="addons" value="fruitBowl" data-price="59"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Fruit Bowl ($59)</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="number" min="0" value="0" 
                                       class="addon-quantity w-20 p-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       data-addon="fruitBowl" disabled>
                                <span class="addon-total w-24 text-right font-medium">$0.00</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="addons" value="potatoSalad" data-price="49"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Potato Salad ($49)</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="number" min="0" value="0" 
                                       class="addon-quantity w-20 p-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       data-addon="potatoSalad" disabled>
                                <span class="addon-total w-24 text-right font-medium">$0.00</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="addons" value="macaroniSalad" data-price="49"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Macaroni Salad ($49)</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="number" min="0" value="0" 
                                       class="addon-quantity w-20 p-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       data-addon="macaroniSalad" disabled>
                                <span class="addon-total w-24 text-right font-medium">$0.00</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="addons" value="salad" data-price="69"
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Salad ($69)</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="number" min="0" value="0" 
                                       class="addon-quantity w-20 p-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       data-addon="salad" disabled>
                                <span class="addon-total w-24 text-right font-medium">$0.00</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-blue-50 rounded-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-700 mb-2">Order Summary</h3>
                    <p class="text-xl font-bold text-blue-600">Total: $<span id="orderTotal">0</span></p>
                </div>

                <button type="button" id="nextToStep2" 
                        class="mt-6 w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Continue to Event Details
                </button>
            </div>

            <!-- Step 2: Event Details -->
            <div class="form-step hidden" id="step2">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Step 2: Event Details</h2>
                
                <div class="bg-white rounded-lg shadow p-6 space-y-6">
                    <div>
                        <label for="fullName" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <input type="text" id="fullName" name="fullName" required
                               class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" id="email" name="email" required
                               class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    
                    <div>
                        <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                        <input type="tel" id="phone" name="phone" required
                               class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    
                    <div>
                        <label for="eventDate" class="block text-sm font-medium text-gray-700 mb-1">Event Date</label>
                        <input type="date" id="eventDate" name="eventDate" required
                               class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    
                    <div>
                        <label for="guestCount" class="block text-sm font-medium text-gray-700 mb-1">Number of Guests</label>
                        <input type="number" id="guestCount" name="guestCount" required
                               class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    
                    <div>
                        <label for="eventType" class="block text-sm font-medium text-gray-700 mb-1">Event Type</label>
                        <input type="text" id="eventType" name="eventType" required
                               class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    
                    <div>
                        <label for="pickupType" class="block text-sm font-medium text-gray-700 mb-1">Pickup Type</label>
                        <select id="pickupType" name="pickupType" required
                                class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Select pickup type</option>
                            <option value="instore">In Store</option>
                            <option value="dropoff">Drop Off</option>
                        </select>
                    </div>
                    
                    <div>
                        <label for="eventLocation" class="block text-sm font-medium text-gray-700 mb-1">Event Location</label>
                        <textarea id="eventLocation" name="eventLocation" required rows="3"
                                  class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                    </div>
                    
                    <div>
                        <label for="comments" class="block text-sm font-medium text-gray-700 mb-1">Comments</label>
                        <textarea id="comments" name="comments" rows="3"
                                  class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                    </div>
                </div>

                <div class="flex space-x-4 mt-6">
                    <button type="button" id="backToStep1" 
                            class="flex-1 bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2">
                        Back to Menu Selection
                    </button>
                    <button type="submit" 
                            class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        Submit Order
                    </button>
                </div>
            </div>
        </form>
    </div>