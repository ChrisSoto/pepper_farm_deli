<div class="flex justify-center items-center lg:max-w-screen-md xl:max-w-screen-lg md:max-w-screen-sm bg-lime-500 w-full shadow-md mx-auto mb-16">
  <div class="flex flex-col justify-center w-full p-4">

    <form id="contact-form" name="contact" method="post" enctype="multipart/form-data" action="https://us-central1-imageonsd-af038.cloudfunctions.net/addPPDContact/" novalidate="">
      <div id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
      <div class="form_fields">

        <div class="grid sm:grid-cols-3 gap-2 sm:gap-4 mb-4">

          <div class="field">
            <label class="field_label block mb-2 text-sm font-bold" for="full-name">Full Name<span class="required mb-2 text-sm font-medium italic pl-2">(Required)</span></label>
            <input name="full_name" id="full-name" type="text" autocomplete="name" required class="shadow-sm bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-3" placeholder="John Doe">
          </div>

          <div class="field">
            <label class="field_label block mb-2 text-sm font-bold" for="e-mail">Email<span class="required mb-2 text-sm font-medium italic pl-2">(Required)</span></label>
            <input name="e_mail" id="e-mail" type="email" autocomplete="email" required class="shadow-sm bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-3" placeholder="john.doe@gmail.com">
          </div>

          <div class="field">
            <label class="field_label block mb-2 text-sm font-bold" for="phone-number">Phone</label>
            <input name="phone_number" id="phone-number" type="tel" autocomplete="tel" class="shadow-sm bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-3" placeholder="Example: 619-312-0941">
          </div>

        </div>

        <div class="field mb-4">
          <label class="field_label block mb-2 text-sm font-bold" for="question">Question<span class="required mb-2 text-sm font-medium italic pl-2">(Required)</span></label>
          <textarea name="question" id="question" required class="textarea shadow-sm bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-3"
            placeholder="Do you use peanut oil in your food?" rows="5" cols="50"></textarea>
        </div>

      </div>

      <input class="form_footer w-full flex flex-row justify-center items-center cursor-pointer text-sm uppercase bg-yellow-400 text-lime-950 p-4 font-bold hover:bg-yellow-300 transition-colors duration-300 button" id="contact-submit" type="submit" value="Submit">
    </form>

  </div>
</div>
