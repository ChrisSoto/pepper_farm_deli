{
  "type": "module",
  "name": "pepper_farm_deli",
  "version": "1.0.0",
  "main": ".eleventy.js",
  "scripts": {
    "watch:eleventy": "eleventy --serve",
    "watch:tailwind": "tailwindcss -i ./_includes/css/tailwind.css -o ./_includes/css/tailwind.out.css --watch",
    "watch:sass": "sass --watch ./_includes/css/global.scss ./_includes/css/global.out.css",
    "build:sass": "sass ./_includes/css/global.scss ./_includes/css/global.out.css",
    "all": "npm-run-all build:sass --parallel watch:*",
    "build:tailwind": "tailwindcss -i ./_includes/css/tailwind.css -o ./_includes/css/tailwind.out.css --minify",
    "build:site": "node scripts/build.mjs",
    "build": "npm-run-all build:sass build:tailwind build:site",
    "audit:seo": "node scripts/audit-seo.mjs",
    "test": "node scripts/test-seo.mjs"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-fetch": "^4.0.1",
    "@11ty/eleventy-img": "^4.0.2",
    "@contentful/rich-text-html-renderer": "^16.6.8",
    "clean-css": "^5.3.3",
    "contentful": "^10.12.6",
    "domutils": "^2.8.0",
    "dotenv": "^16.4.5",
    "firebase": "^10.12.2",
    "htmlparser2": "^7.2.0",
    "markdown-it": "^14.1.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.6",
    "tailwindcss": "^3.4.4"
  }
}
